# Phoenix on RupertCloud — copy to .env and fill in. Never commit .env.

# ── required ──────────────────────────────────────────────────────────────────
# The gateway key from https://api.ripaplatform.com/_dash. Its presence alone turns the
# brain on (default endpoint api.ripaplatform.com, default model qwen3:30b). When
# BRAIN_BASE_URL points at a local Ollama, any non-empty value will do.
BRAIN_API_KEY=sk-REPLACE-ME

# ── strongly recommended on your own host ─────────────────────────────────────
# Ollama on the same machine, reached directly (compose maps host.docker.internal):
BRAIN_BASE_URL=http://host.docker.internal:11434/v1
# A NON-thinking build. qwen3:30b is the thinking build and reasons on every call.
BRAIN_MODEL=qwen3:30b-instruct
# Locks every mutating endpoint, including the improvement gate. Pages stay readable.
CONSOLE_TOKEN=change-me
# Fine-grained token for amonxnye/Phoenix (contents + pull requests: write). With it an
# approval on /improve pushes a branch and opens a DRAFT pull request.
GITHUB_TOKEN=
# Seed a demo game on first boot.
SEED=1

# ── optional (defaults shown) ─────────────────────────────────────────────────
#PHOENIX_PORT=8788                 # host port mapped to the container
#IMPROVE=1                         # Article XI cycle; 0 disables
#IMPROVE_INTERVAL_S=3600           # every hour
#IMPROVE_AUTO_PR=1                 # verified patches open draft PRs on their own (needs GITHUB_TOKEN)
#IMPROVE_PUSH_BRANCH=              # or commit them straight onto this branch (the deploy branch = live, unreviewed; revert on /improve)
#IMPROVE_MAX_TRIES=10              # patches tried per cycle (each = one suite run on a copy)
#IMPROVE_SUITES=governor,work,settlement,mechanic
#IMPROVE_REPO=amonxnye/Phoenix
#MECHANIC_BASE_URL=                # give the mechanic alone another endpoint…
#MECHANIC_API_KEY=
#MECHANIC_MODEL=                   # …and model (all three required together)
#MECHANIC_PRICE=                   # self-hosted (inferred) | cheap | strong
#MECHANIC_PROVIDER_DOWN_AFTER=5
#BRAIN_TIMEOUT_S=300
#BRAIN_NATIVE=0                    # 1: Ollama /api/chat with think:false (non-thinking models only)
#BRAIN_MODEL_FALLBACKS=            # comma list, used on 403 model_disabled
#NET_RETRIES=5
#NET_BACKOFF_S=1
#NET_BREAK_AFTER=2
#NET_COOL_S=60
#SANDBOX_NETNS=1                   # 0 disables the private network namespace
#PUBLIC_CHAT=0
#LANGSMITH_TRACING=false
#LANGSMITH_API_KEY=
#LANGSMITH_PROJECT=
