# Keep the build context small and the image clean.
.git
.github
__pycache__/
*.py[cod]

# Local state. These are per-machine and some are secrets — a session-signing key
# baked into an image would be the same key for every deployment of it.
*.sqlite
*.sqlite-wal
*.sqlite-shm
gov/gate-secret
gov/workspaces/
gov/aoe-events.jsonl
scorecard.json
gov/scorecard.json

# Screenshots, notes, anything a build does not need
*.png
